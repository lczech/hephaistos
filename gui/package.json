{
  "name": "hephaistos",
  "productName": "hephaistos",
  "desktopName": "hephaistos.desktop",
  "private": true,
  "type": "module",
  "main": "desktop/dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "types": "openapi-typescript web/openapi.json --output web/src/api/schema.d.ts --silent",
    "dev": "npm run types && vite web",
    "build": "npm run types && tsc -p web && vite build web && tsc -p desktop/tsconfig.build.json",
    "check": "npm run types && tsc -p web && tsc -p desktop && vitest run",
    "lint": "biome check",
    "format": "biome check --write",
    "fetch-electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.3.1",
    "dockview-react": "8.5.1",
    "electron": "44.7.2",
    "lucide-react": "1.56.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
