// React's compiler memoizes every component and hook (gui/web/vite.config.ts): memoizing by hand
// only adds code, and says the compiler is not trusted.
language js

or {
  `useMemo($args)`,
  `useCallback($args)`,
  `memo($args)`,
  `React.memo($args)`
} as $call where {
  register_diagnostic(span=$call, message="Do not memoize by hand: React's compiler memoizes every component and hook.")
}
